# Never commit the real file. The wallet below is the mouse's wallet: it creates the coin,
# receives creator fees, pays the rewards, and is the only wallet the bot ever signs with.
MOUSEDEV_PRIVATE_KEY=            # base58 secret key
# The full holder list needs an RPC that allows getProgramAccounts (most paid ones do).
# On the free public endpoint the bot falls back to the 20 largest token accounts.
# one URL, or several separated by commas; the first is used, the others take over when it fails
MOUSEDEV_RPC_URL=https://api.mainnet-beta.solana.com
TELEGRAM_BOT_TOKEN=
PINATA_JWT=                      # only needed if the rig uploads the coin picture for you
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
